# Synthetic local development examples only; these are not real credentials.
# Compose works without copying this file. Its database credentials are fixed
# in compose.yaml and docker/mysql/init.sql so the fixture grants stay consistent.
# Compose reads these optional host settings from .env:
APP_PORT=3000
RAILS_MAX_THREADS=5

# Native Ruby mode: export these variables in your shell. Rails does not load
# this file automatically. Use a separate locally provisioned MySQL instance;
# the Compose MySQL service deliberately does not publish a host port.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=commerce_event_ledger
DB_PASSWORD=ledger-local-only
